# API-Sports / API-Football key (https://dashboard.api-football.com).
# Free tier: 100 requests/day, ~10 requests/minute.
# Without this the site still renders the committed roster, but shows no fixtures.
API_FOOTBALL_KEY=

# Optional: skip the national-team lookup in `npm run refresh:roster` by pinning
# API-Football team ids. As of the last check: men's = 1113, women's = 14455.
BIH_MEN_TEAM_ID=
BIH_WOMEN_TEAM_ID=
